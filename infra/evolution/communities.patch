+// DTO сообществ WhatsApp (патч onAI, этап A2). Маршруты: src/api/routes/community.router.ts.
+export class CommunityJid {
+  communityJid: string;
+}
+
+export class CreateCommunityDto {
+  subject: string;
+  description?: string;
+  approvalRequired?: boolean;
+}
+
+export class CommunityInfoDto extends CommunityJid {
+  /** 'true' добавляет в ответ список участников сообщества (по умолчанию не отдаётся). */
+  participants?: string;
+}
+
+export class CommunityUpdateSettingDto extends CommunityJid {
+  action: 'announcement' | 'not_announcement' | 'locked' | 'unlocked';
+}
+
+export class CommunityMemberAddModeDto extends CommunityJid {
+  mode: 'admin_add' | 'all_member_add';
+}
+
+export class CommunityJoinApprovalModeDto extends CommunityJid {
+  mode: 'on' | 'off';
+}
+
+export class CommunityRequestsUpdateDto extends CommunityJid {
+  /** JID из списка заявок (как пришли) или голые номера. */
+  participants: string[];
+  action: 'approve' | 'reject';
+}
diff --git a/src/api/integrations/channel/whatsapp/community.helpers.ts b/src/api/integrations/channel/whatsapp/community.helpers.ts
new file mode 100644
index 0000000..2aea45a
--- /dev/null
+++ b/src/api/integrations/channel/whatsapp/community.helpers.ts
@@ -0,0 +1,259 @@
+// Вспомогательные функции сообществ WhatsApp (патч onAI, этап A2).
+// Чистые функции над сокетом Baileys 7.0.0-rc.9: без импортов Evolution, чтобы их можно было проверить на подставном сокете.
+// Исходники Baileys, по которым написано: node_modules/baileys/lib/Socket/communities.js и groups.js.
+import { generateMessageID, getBinaryNodeChild, getBinaryNodeChildren, jidEncode } from 'baileys';
+
+/** Минимум от сокета, который нужен хелперам (query и groupMetadata есть в WASocket rc.9). */
+export interface CommunitySocketLike {
+  query: (node: any, timeoutMs?: number) => Promise<any>;
+  groupMetadata: (jid: string) => Promise<any>;
+}
+
+export interface CreateCommunityParams {
+  subject: string;
+  description?: string;
+  approvalRequired?: boolean;
+}
+
+export interface LinkedGroupInfo {
+  id: string | undefined;
+  subject: string;
+  creation: number | undefined;
+  owner: string | undefined;
+  size: number | undefined;
+  /** В ответе WhatsApp у группы есть признак вкладки объявлений (default_sub_group). */
+  isAnnouncement: boolean;
+  /** Исходные атрибуты узла group из ответа sub_groups, чтобы на живом номере увидеть всё как есть. */
+  attrs: Record<string, string>;
+  /** Имена дочерних узлов group (для диагностики). */
+  tags: string[];
+}
+
+export type AnnouncementSource =
+  | 'sub_groups.default_sub_group'
+  | 'single_linked_group'
+  | 'group_metadata.isCommunityAnnounce';
+
+export interface AnnouncementLookup {
+  announcementJid: string | null;
+  source: AnnouncementSource | null;
+  linkedGroups: LinkedGroupInfo[];
+}
+
+/** Ошибка с готовым текстом для пользователя: describeWaError отдаёт её сообщение как есть. */
+export class CommunityUserError extends Error {}
+
+const G_US = 'g.us';
+
+/** Теги признака вкладки объявлений: в groups.js rc.9 это default_sub_group, в communities.js rc.9 default_sub_community. */
+const ANNOUNCE_TAGS = ['default_sub_group', 'default_sub_community'];
+
+/** Сколько подгрупп максимум проверять через groupMetadata, если признак в ответе не пришёл. */
+const METADATA_SCAN_LIMIT = 20;
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/** '1203630000000000@g.us' остаётся как есть, '1203630000000000' получает суффикс. */
+export function toGroupJid(value: string): string {
+  const v = String(value ?? '').trim();
+  return v.includes('@') ? v : jidEncode(v, G_US);
+}
+
+/**
+ * Создание сообщества своим IQ-запросом. За основу взят communityCreate из rc.9, но без двух тегов:
+ * allow_non_admin_sub_group_creation (подгруппы от участников) и create_general_chat (общий чат).
+ * Тег parent с default_membership_approval_mode добавляется только при approvalRequired.
+ * Описание отправляется, только если оно не пустое.
+ * Возвращает JID сообщества.
+ */
+export async function createCommunityRaw(client: CommunitySocketLike, params: CreateCommunityParams): Promise<string> {
+  const content: any[] = [];
+
+  const description = (params.description ?? '').trim();
+  if (description) {
+    content.push({
+      tag: 'description',
+      attrs: { id: generateMessageID().substring(0, 12) },
+      content: [{ tag: 'body', attrs: {}, content: Buffer.from(description, 'utf-8') }],
+    });
+  }
+
+  content.push({
+    tag: 'parent',
+    attrs: params.approvalRequired ? { default_membership_approval_mode: 'request_required' } : {},
+  });
+
+  const result = await client.query({
+    tag: 'iq',
+    attrs: { type: 'set', xmlns: 'w:g2', to: '@g.us' },
+    content: [{ tag: 'create', attrs: { subject: params.subject }, content }],
+  });
+
+  const groupNode = getBinaryNodeChild(result, 'group');
+  const id = groupNode?.attrs?.id;
+  if (!id) {
+    throw new CommunityUserError('WhatsApp не вернул JID созданного сообщества');
+  }
+
+  return toGroupJid(id);
+}
+
+/**
+ * Привязанные группы сообщества. Тот же запрос sub_groups, что в communityFetchLinkedGroups из rc.9,
+ * но с разбором дочерних узлов: так видно, какая группа помечена как вкладка объявлений.
+ */
+export async function fetchLinkedGroups(client: CommunitySocketLike, communityJid: string): Promise<LinkedGroupInfo[]> {
+  const result = await client.query({
+    tag: 'iq',
+    attrs: { type: 'get', xmlns: 'w:g2', to: communityJid },
+    content: [{ tag: 'sub_groups', attrs: {} }],
+  });
+
+  const subGroupsNode = getBinaryNodeChild(result, 'sub_groups');
+  const groups = getBinaryNodeChildren(subGroupsNode, 'group');
+
+  return groups.map((node) => {
+    const attrs = (node.attrs || {}) as Record<string, string>;
+    const tags = Array.isArray(node.content) ? node.content.map((child: any) => String(child?.tag)) : [];
+    const size = attrs.size !== undefined && attrs.size !== '' ? Number(attrs.size) : undefined;
+    const creation = attrs.creation ? Number(attrs.creation) : undefined;
+
+    return {
+      id: attrs.id ? toGroupJid(attrs.id) : undefined,
+      subject: attrs.subject || '',
+      creation: Number.isFinite(creation) ? creation : undefined,
+      owner: attrs.creator || undefined,
+      size: Number.isFinite(size) ? size : undefined,
+      isAnnouncement: tags.some((tag) => ANNOUNCE_TAGS.includes(tag)),
+      attrs,
+      tags,
+    };
+  });
+}
+
+/**
+ * Один проход поиска вкладки объявлений. Порядок проверок:
+ * 1. признак default_sub_group в ответе sub_groups;
+ * 2. единственная привязанная группа (у только что созданного сообщества без общего чата она одна, это и есть вкладка объявлений);
+ * 3. метаданные каждой подгруппы, признак isCommunityAnnounce (groupMetadata rc.9 читает default_sub_group).
+ */
+export async function detectAnnouncement(
+  client: CommunitySocketLike,
+  communityJid: string,
+): Promise<AnnouncementLookup> {
+  const linkedGroups = await fetchLinkedGroups(client, communityJid);
+
+  const flagged = linkedGroups.find((group) => group.isAnnouncement && group.id);
+  if (flagged) {
+    return { announcementJid: flagged.id!, source: 'sub_groups.default_sub_group', linkedGroups };
+  }
+
+  const candidates = linkedGroups.filter((group) => group.id);
+  if (candidates.length === 1) {
+    return { announcementJid: candidates[0].id!, source: 'single_linked_group', linkedGroups };
+  }
+
+  for (const group of candidates.slice(0, METADATA_SCAN_LIMIT)) {
+    try {
+      const meta = await client.groupMetadata(group.id!);
+      if (meta?.isCommunityAnnounce) {
+        return { announcementJid: group.id!, source: 'group_metadata.isCommunityAnnounce', linkedGroups };
+      }
+    } catch {
+      // Подгруппа могла не ответить, идём дальше по списку.
+    }
+  }
+
+  return { announcementJid: null, source: null, linkedGroups };
+}
+
+/** Поиск вкладки объявлений с повторами: сразу после создания WhatsApp может отдать пустой список. */
+export async function waitForAnnouncement(
+  client: CommunitySocketLike,
+  communityJid: string,
+  options: { attempts?: number; delayMs?: number } = {},
+): Promise<AnnouncementLookup> {
+  const attempts = Math.max(1, options.attempts ?? 4);
+  const delayMs = options.delayMs ?? 1500;
+
+  let last: AnnouncementLookup = { announcementJid: null, source: null, linkedGroups: [] };
+  let lastError: unknown;
+
+  for (let i = 0; i < attempts; i++) {
+    if (i > 0) await sleep(delayMs);
+    try {
+      last = await detectAnnouncement(client, communityJid);
+      lastError = undefined;
+      if (last.announcementJid) return last;
+    } catch (error) {
+      lastError = error;
+    }
+  }
+
+  // Все попытки закончились ошибкой: отдаём её наверх, пусть вызывающий решит, что с этим делать.
+  if (lastError) throw lastError;
+  return last;
+}
+
+/** Участники заявок: строки с @ идут как есть (jid из списка заявок), голые номера превращаются в JID через переданную функцию. */
+export function normalizeRequestParticipants(participants: string[], toJid: (value: string) => string): string[] {
+  return participants.map((participant) => {
+    const value = String(participant).trim();
+    return value.includes('@') ? value : toJid(value);
+  });
+}
+
+export interface WaErrorDescription {
+  /** Понятный текст причины по-русски. */
+  reason: string;
+  /** Исходная ошибка WhatsApp/Baileys: текст и код. */
+  raw: string;
+}
+
+/**
+ * Перевод ошибки WhatsApp в понятный текст. IQ-ошибка в Baileys это Boom(text, { data: code }),
+ * text берётся из атрибута text узла error (forbidden, not-authorized, item-not-found и так далее).
+ */
+export function describeWaError(error: any): WaErrorDescription {
+  if (error instanceof CommunityUserError) {
+    return { reason: error.message, raw: '' };
+  }
+
+  const message = String(error?.message ?? error ?? 'unknown error');
+  const lower = message.toLowerCase();
+  const codeFromData = Number(error?.data);
+  const code =
+    Number.isFinite(codeFromData) && codeFromData > 0 ? codeFromData : Number(error?.output?.statusCode) || 0;
+  const raw = code ? `${message} (код ${code})` : message;
+
+  let reason: string;
+
+  if (
+    lower.includes('connection closed') ||
+    lower.includes('connection terminated') ||
+    lower.includes('connection was lost') ||
+    lower.includes('cannot read properties of undefined') ||
+    lower.includes('cannot read properties of null')
+  ) {
+    reason = 'Нет активного подключения к WhatsApp: инстанс не подключён или соединение оборвалось';
+  } else if (lower.includes('timed out') || code === 408) {
+    reason =
+      'WhatsApp не ответил вовремя (таймаут). Если это было создание сообщества, проверьте список групп, прежде чем повторять';
+  } else if (lower.includes('not-authorized') || lower.includes('forbidden') || code === 401 || code === 403) {
+    reason = 'WhatsApp отказал: у подключённого номера нет прав на это действие (нужен админ сообщества)';
+  } else if (lower.includes('item-not-found') || lower === 'gone' || code === 404 || code === 410) {
+    reason = 'Сообщество или группа не найдены: неверный JID или номер уже не состоит в нём';
+  } else if (lower.includes('rate-overlimit') || code === 429) {
+    reason = 'WhatsApp ограничил частоту запросов, повторите позже';
+  } else if (lower.includes('resource-limit') || lower.includes('not-acceptable') || code === 406) {
+    reason = 'Достигнут лимит WhatsApp на это действие или значение недопустимо';
+  } else if (lower.includes('conflict') || code === 409) {
+    reason = 'Конфликт состояния: такое значение уже установлено или не подходит к текущим настройкам';
+  } else if (lower.includes('bad-request') || code === 400) {
+    reason = 'WhatsApp не принял запрос: проверьте параметры (JID, название, режим)';
+  } else {
+    reason = 'WhatsApp вернул ошибку';
+  }
+
+  return { reason, raw };
+}
