+import {
+  CommunityInfoDto,
+  CommunityJid,
+  CommunityJoinApprovalModeDto,
+  CommunityMemberAddModeDto,
+  CommunityRequestsUpdateDto,
+  CommunityUpdateSettingDto,
+  CreateCommunityDto,
+} from '@api/dto/community.dto';
+import { InstanceDto } from '@api/dto/instance.dto';
+import { WAMonitoringService } from '@api/services/monitor.service';
+import { BadRequestException } from '@exceptions';
+
+// Сообщества WhatsApp (патч onAI, этап A2). Методы живут только в канале Baileys (WHATSAPP-BAILEYS).
+export class CommunityController {
+  constructor(private readonly waMonitor: WAMonitoringService) {}
+
+  private baileysInstance(instance: InstanceDto) {
+    const wa = this.waMonitor.waInstances[instance.instanceName];
+
+    if (!wa) {
+      throw new BadRequestException('Инстанс не загружен', `instance = ${instance.instanceName}`);
+    }
+
+    if (typeof wa.createCommunity !== 'function') {
+      throw new BadRequestException('Сообщества доступны только для интеграции WHATSAPP-BAILEYS');
+    }
+
+    const state = wa.connectionStatus?.state;
+    if (state !== 'open') {
+      throw new BadRequestException(
+        'Инстанс не подключён к WhatsApp',
+        `connectionStatus.state = ${state ?? 'unknown'}`,
+      );
+    }
+
+    return wa;
+  }
+
+  public async createCommunity(instance: InstanceDto, create: CreateCommunityDto) {
+    return await this.baileysInstance(instance).createCommunity(create);
+  }
+
+  public async communityInfo(instance: InstanceDto, data: CommunityInfoDto) {
+    return await this.baileysInstance(instance).communityInfo(data);
+  }
+
+  public async inviteCode(instance: InstanceDto, data: CommunityJid) {
+    return await this.baileysInstance(instance).communityInviteCode(data);
+  }
+
+  public async revokeInvite(instance: InstanceDto, data: CommunityJid) {
+    return await this.baileysInstance(instance).communityRevokeInvite(data);
+  }
+
+  public async updateSetting(instance: InstanceDto, data: CommunityUpdateSettingDto) {
+    return await this.baileysInstance(instance).communityUpdateSetting(data);
+  }
+
+  public async memberAddMode(instance: InstanceDto, data: CommunityMemberAddModeDto) {
+    return await this.baileysInstance(instance).communityMemberAddMode(data);
+  }
+
+  public async joinApprovalMode(instance: InstanceDto, data: CommunityJoinApprovalModeDto) {
+    return await this.baileysInstance(instance).communityJoinApprovalMode(data);
+  }
+
+  public async requests(instance: InstanceDto, data: CommunityJid) {
+    return await this.baileysInstance(instance).communityRequests(data);
+  }
+
+  public async requestsUpdate(instance: InstanceDto, data: CommunityRequestsUpdateDto) {
+    return await this.baileysInstance(instance).communityRequestsUpdate(data);
+  }
+}
