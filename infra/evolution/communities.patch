+  // Сообщества WhatsApp (патч onAI, этап A2, см. infra/evolution/README.md в репозитории воркшопа).
+  // Опираются на сокет Baileys rc.9: communities.js (invite, setting, member_add_mode, join approval, заявки) и свои IQ-запросы.
+  private communityFail(title: string, error: any, status: 'bad' | 'internal' = 'bad'): never {
+    this.logger.error(error);
+    const { reason, raw } = describeWaError(error);
+
+    const details = raw ? [reason, raw] : [reason];
+
+    if (status === 'internal') {
+      throw new InternalServerErrorException(title, ...details);
+    }
+    throw new BadRequestException(title, ...details);
+  }
+
+  public async createCommunity(data: CreateCommunityDto) {
+    let communityJid: string;
+
+    try {
+      communityJid = await createCommunityRaw(this.client, {
+        subject: data.subject.trim(),
+        description: data.description,
+        approvalRequired: data.approvalRequired === true,
+      });
+    } catch (error) {
+      this.communityFail('Не удалось создать сообщество', error, 'internal');
+    }
+
+    // Сообщество уже создано: если вкладку объявлений найти не удалось, отдаём JID сообщества и announcementJid = null,
+    // чтобы вызывающий не потерял сообщество и повторил поиск через GET /community/info.
+    try {
+      const found = await waitForAnnouncement(this.client, communityJid, { attempts: 4, delayMs: 1500 });
+
+      return {
+        communityJid,
+        announcementJid: found.announcementJid,
+        announcementSource: found.source,
+        warning: found.announcementJid
+          ? undefined
+          : 'Сообщество создано, но вкладка объявлений пока не найдена: повторите запрос GET /community/info',
+      };
+    } catch (error) {
+      this.logger.error(error);
+      const { reason, raw } = describeWaError(error);
+
+      return {
+        communityJid,
+        announcementJid: null,
+        announcementSource: null,
+        warning: `Сообщество создано, но вкладку объявлений найти не удалось: ${reason}${raw ? ` (${raw})` : ''}`,
+      };
+    }
+  }
+
+  public async communityInfo(data: CommunityInfoDto) {
+    try {
+      const meta = await this.client.groupMetadata(data.communityJid);
+
+      if (meta?.linkedParent) {
+        throw new CommunityUserError(`Это подгруппа сообщества ${meta.linkedParent}, укажите JID сообщества`);
+      }
+
+      const { participants, ...rest } = meta;
+      const lookup = await detectAnnouncement(this.client, data.communityJid);
+
+      return {
+        ...rest,
+        linkedGroups: lookup.linkedGroups,
+        announcementJid: lookup.announcementJid,
+        announcementSource: lookup.source,
+        ...(data.participants === 'true' ? { participants } : {}),
+      };
+    } catch (error) {
+      this.communityFail('Не удалось получить данные сообщества', error);
+    }
+  }
+
+  public async communityInviteCode(data: CommunityJid) {
+    try {
+      const code = await this.client.communityInviteCode(data.communityJid);
+      if (!code) {
+        throw new CommunityUserError('WhatsApp не вернул код приглашения');
+      }
+      return { inviteUrl: `https://chat.whatsapp.com/${code}`, inviteCode: code };
+    } catch (error) {
+      this.communityFail('Не удалось получить ссылку сообщества', error);
+    }
+  }
+
+  public async communityRevokeInvite(data: CommunityJid) {
+    try {
+      const code = await this.client.communityRevokeInvite(data.communityJid);
+      if (!code) {
+        throw new CommunityUserError('WhatsApp не вернул новый код приглашения');
+      }
+      return { revoked: true, inviteUrl: `https://chat.whatsapp.com/${code}`, inviteCode: code };
+    } catch (error) {
+      this.communityFail('Не удалось сбросить ссылку сообщества', error);
+    }
+  }
+
+  public async communityUpdateSetting(data: CommunityUpdateSettingDto) {
+    try {
+      await this.client.communitySettingUpdate(data.communityJid, data.action);
+      return { updated: true, communityJid: data.communityJid, action: data.action };
+    } catch (error) {
+      this.communityFail('Не удалось изменить настройку сообщества', error);
+    }
+  }
+
+  public async communityMemberAddMode(data: CommunityMemberAddModeDto) {
+    try {
+      await this.client.communityMemberAddMode(data.communityJid, data.mode);
+      return { updated: true, communityJid: data.communityJid, mode: data.mode };
+    } catch (error) {
+      this.communityFail('Не удалось изменить режим добавления участников', error);
+    }
+  }
+
+  public async communityJoinApprovalMode(data: CommunityJoinApprovalModeDto) {
+    try {
+      await this.client.communityJoinApprovalMode(data.communityJid, data.mode);
+      return { updated: true, communityJid: data.communityJid, mode: data.mode };
+    } catch (error) {
+      this.communityFail('Не удалось изменить режим одобрения вступления', error);
+    }
+  }
+
+  public async communityRequests(data: CommunityJid) {
+    try {
+      // Атрибуты заявок отдаются как пришли от WhatsApp (jid, phone_number, request_method, request_time и что ещё придёт).
+      const requests = await this.client.communityRequestParticipantsList(data.communityJid);
+      return { communityJid: data.communityJid, count: requests.length, requests };
+    } catch (error) {
+      this.communityFail('Не удалось получить заявки на вступление', error);
+    }
+  }
+
+  public async communityRequestsUpdate(data: CommunityRequestsUpdateDto) {
+    try {
+      const participants = normalizeRequestParticipants(data.participants, (value) => createJid(value));
+      const results = await this.client.communityRequestParticipantsUpdate(
+        data.communityJid,
+        participants,
+        data.action,
+      );
+      return { communityJid: data.communityJid, action: data.action, results };
+    } catch (error) {
+      this.communityFail('Не удалось обработать заявки на вступление', error);
+    }
+  }
+
   public async templateMessage() {
     throw new Error('Method not available in the Baileys service');
   }
