@@ -0,0 +1,105 @@
+// Схемы валидации сообществ WhatsApp (патч onAI, этап A2), по образцу group.schema.ts.
+import { JSONSchema7 } from 'json-schema';
+import { v4 } from 'uuid';
+
+const JID_HINT = 'The "communityJid" must be a WhatsApp group JID like 120363000000000000@g.us';
+
+// JID сообщества это обычный JID группы: цифры и дефис плюс @g.us (суффикс router добавляет сам).
+export const communityJidSchema: JSONSchema7 = {
+  $id: v4(),
+  type: 'object',
+  properties: {
+    communityJid: { type: 'string', pattern: '^[\\d-]+@g.us$', description: JID_HINT },
+  },
+  required: ['communityJid'],
+};
+
+export const createCommunitySchema: JSONSchema7 = {
+  $id: v4(),
+  type: 'object',
+  properties: {
+    subject: {
+      type: 'string',
+      minLength: 1,
+      maxLength: 100,
+      pattern: '\\S',
+      description: 'The "subject" must be 1-100 characters and not blank',
+    },
+    description: { type: 'string', maxLength: 2048, description: 'The "description" must be up to 2048 characters' },
+    approvalRequired: { type: 'boolean', description: 'The "approvalRequired" must be true or false' },
+  },
+  required: ['subject'],
+};
+
+export const communityInfoSchema: JSONSchema7 = {
+  $id: v4(),
+  type: 'object',
+  properties: {
+    communityJid: { type: 'string', pattern: '^[\\d-]+@g.us$', description: JID_HINT },
+    participants: {
+      type: 'string',
+      enum: ['true', 'false'],
+      description: 'The "participants" must be "true" or "false"',
+    },
+  },
+  required: ['communityJid'],
+};
+
+export const communityUpdateSettingSchema: JSONSchema7 = {
+  $id: v4(),
+  type: 'object',
+  properties: {
+    communityJid: { type: 'string', pattern: '^[\\d-]+@g.us$', description: JID_HINT },
+    action: {
+      type: 'string',
+      enum: ['announcement', 'not_announcement', 'locked', 'unlocked'],
+      description: 'The "action" must be announcement, not_announcement, locked or unlocked',
+    },
+  },
+  required: ['communityJid', 'action'],
+};
+
+export const communityMemberAddModeSchema: JSONSchema7 = {
+  $id: v4(),
+  type: 'object',
+  properties: {
+    communityJid: { type: 'string', pattern: '^[\\d-]+@g.us$', description: JID_HINT },
+    mode: {
+      type: 'string',
+      enum: ['admin_add', 'all_member_add'],
+      description: 'The "mode" must be admin_add or all_member_add',
+    },
+  },
+  required: ['communityJid', 'mode'],
+};
+
+export const communityJoinApprovalModeSchema: JSONSchema7 = {
+  $id: v4(),
+  type: 'object',
+  properties: {
+    communityJid: { type: 'string', pattern: '^[\\d-]+@g.us$', description: JID_HINT },
+    mode: { type: 'string', enum: ['on', 'off'], description: 'The "mode" must be on or off' },
+  },
+  required: ['communityJid', 'mode'],
+};
+
+export const communityRequestsUpdateSchema: JSONSchema7 = {
+  $id: v4(),
+  type: 'object',
+  properties: {
+    communityJid: { type: 'string', pattern: '^[\\d-]+@g.us$', description: JID_HINT },
+    action: { type: 'string', enum: ['approve', 'reject'], description: 'The "action" must be approve or reject' },
+    participants: {
+      type: 'array',
+      minItems: 1,
+      maxItems: 256,
+      uniqueItems: true,
+      items: {
+        type: 'string',
+        minLength: 5,
+        description: '"participants" must be an array of JIDs from the requests list or numeric strings',
+      },
+    },
+  },
+  required: ['communityJid', 'action', 'participants'],
+};
