+++ b/src/api/routes/community.router.ts
@@ -0,0 +1,184 @@
+import { RouterBroker } from '@api/abstract/abstract.router';
+import {
+  CommunityInfoDto,
+  CommunityJid,
+  CommunityJoinApprovalModeDto,
+  CommunityMemberAddModeDto,
+  CommunityRequestsUpdateDto,
+  CommunityUpdateSettingDto,
+  CreateCommunityDto,
+} from '@api/dto/community.dto';
+import { InstanceDto } from '@api/dto/instance.dto';
+import { communityController } from '@api/server.module';
+import { Logger } from '@config/logger.config';
+import { BadRequestException } from '@exceptions';
+import {
+  communityInfoSchema,
+  communityJidSchema,
+  communityJoinApprovalModeSchema,
+  communityMemberAddModeSchema,
+  communityRequestsUpdateSchema,
+  communityUpdateSettingSchema,
+  createCommunitySchema,
+} from '@validate/validate.schema';
+import { RequestHandler, Router } from 'express';
+import { JSONSchema7 } from 'json-schema';
+import { validate } from 'jsonschema';
+
+import { HttpStatus } from './index.router';
+
+const logger = new Logger('CommunityRouter');
+
+type CommunityValidateArgs<T> = {
+  request: any;
+  schema: JSONSchema7;
+  ClassRef: any;
+  execute: (instance: InstanceDto, data: T) => Promise<any>;
+};
+
+// Сообщества WhatsApp (патч onAI, этап A2): маршруты /community/*, ключ API и инстанс проверяют общие guards.
+export class CommunityRouter extends RouterBroker {
+  constructor(...guards: RequestHandler[]) {
+    super();
+    this.router
+      .post(this.routerPath('create'), ...guards, async (req, res) => {
+        const response = await this.dataValidate<CreateCommunityDto>({
+          request: req,
+          schema: createCommunitySchema,
+          ClassRef: CreateCommunityDto,
+          execute: (instance, data) => communityController.createCommunity(instance, data),
+        });
+
+        res.status(HttpStatus.CREATED).json(response);
+      })
+      .get(this.routerPath('info'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityInfoDto>({
+          request: req,
+          schema: communityInfoSchema,
+          ClassRef: CommunityInfoDto,
+          execute: (instance, data) => communityController.communityInfo(instance, data),
+        });
+
+        res.status(HttpStatus.OK).json(response);
+      })
+      .get(this.routerPath('inviteCode'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityJid>({
+          request: req,
+          schema: communityJidSchema,
+          ClassRef: CommunityJid,
+          execute: (instance, data) => communityController.inviteCode(instance, data),
+        });
+
+        res.status(HttpStatus.OK).json(response);
+      })
+      .post(this.routerPath('revokeInvite'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityJid>({
+          request: req,
+          schema: communityJidSchema,
+          ClassRef: CommunityJid,
+          execute: (instance, data) => communityController.revokeInvite(instance, data),
+        });
+
+        res.status(HttpStatus.CREATED).json(response);
+      })
+      .post(this.routerPath('updateSetting'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityUpdateSettingDto>({
+          request: req,
+          schema: communityUpdateSettingSchema,
+          ClassRef: CommunityUpdateSettingDto,
+          execute: (instance, data) => communityController.updateSetting(instance, data),
+        });
+
+        res.status(HttpStatus.CREATED).json(response);
+      })
+      .post(this.routerPath('memberAddMode'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityMemberAddModeDto>({
+          request: req,
+          schema: communityMemberAddModeSchema,
+          ClassRef: CommunityMemberAddModeDto,
+          execute: (instance, data) => communityController.memberAddMode(instance, data),
+        });
+
+        res.status(HttpStatus.CREATED).json(response);
+      })
+      .post(this.routerPath('joinApprovalMode'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityJoinApprovalModeDto>({
+          request: req,
+          schema: communityJoinApprovalModeSchema,
+          ClassRef: CommunityJoinApprovalModeDto,
+          execute: (instance, data) => communityController.joinApprovalMode(instance, data),
+        });
+
+        res.status(HttpStatus.CREATED).json(response);
+      })
+      .get(this.routerPath('requests'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityJid>({
+          request: req,
+          schema: communityJidSchema,
+          ClassRef: CommunityJid,
+          execute: (instance, data) => communityController.requests(instance, data),
+        });
+
+        res.status(HttpStatus.OK).json(response);
+      })
+      .post(this.routerPath('requests'), ...guards, async (req, res) => {
+        const response = await this.communityValidate<CommunityRequestsUpdateDto>({
+          request: req,
+          schema: communityRequestsUpdateSchema,
+          ClassRef: CommunityRequestsUpdateDto,
+          execute: (instance, data) => communityController.requestsUpdate(instance, data),
+        });
+
+        res.status(HttpStatus.CREATED).json(response);
+      });
+  }
+
+  public readonly router: Router = Router();
+
+  // По образцу groupValidate: communityJid берётся из тела или из query, суффикс @g.us добавляется сам.
+  // Остальные параметры query (например participants=true) попадают в данные запроса.
+  private async communityValidate<T>(args: CommunityValidateArgs<T>) {
+    const { request, ClassRef, schema, execute } = args;
+
+    const instance = request.params as unknown as InstanceDto;
+    const body = request.body && typeof request.body === 'object' ? request.body : {};
+    const query = request.query && typeof request.query === 'object' ? request.query : {};
+
+    let communityJid = body.communityJid ?? query.communityJid;
+
+    if (!communityJid || typeof communityJid !== 'string') {
+      throw new BadRequestException(
+        'The community id needs to be informed in the query',
+        'ex: "communityJid=120362@g.us"',
+      );
+    }
+
+    if (!communityJid.endsWith('@g.us')) {
+      communityJid = communityJid + '@g.us';
+    }
+
+    const ref = new ClassRef();
+    Object.assign(ref, query, body, { communityJid });
+
+    const v = validate(ref, schema);
+
+    if (!v.valid) {
+      const message: any[] = v.errors.map(({ property, stack, schema }) => {
+        let message: string;
+        if (schema['description']) {
+          message = schema['description'];
+        } else {
+          message = stack.replace('instance.', '');
+        }
+        return {
+          property: property.replace('instance.', ''),
+          message,
+        };
+      });
+      logger.error([...message]);
+      throw new BadRequestException(...message);
+    }
+
+    return await execute(instance, ref);
+  }
+}
